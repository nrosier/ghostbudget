# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
*.test.js
tests/

# Development files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation. `*.md` matches the repository root only — a single `*` does not
# cross a `/` — so docs/ needs its own entry or the whole tree lands in the image.
*.md
docs/

# Configuration examples (not actual configs)
.env.example
config.json.example

# Real secrets and configuration — these are gitignored, so they only ever exist
# in a local working tree. Without these rules a local `docker build` bakes live
# credentials into an image layer (the Dockerfile does `COPY . .`).
.env
.env.*
**/.env
config*.json
**/config*.json

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Developer and bot tooling. None of it is read at runtime — the image installs with
# --omit=dev and runs src/scheduler.js — and `COPY . .` would otherwise bake all of it
# into a layer. `config*.json` above does not cover renovate.json.
renovate.json
eslint.config.js
jest.config.js
jest.setup.js
.prettierrc.json
.prettierignore
.nvmrc

# Build artifacts
dist/
build/

# Temporary files
tmp/
temp/

# Made with Bob
