# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
*.test.js
tests/

# Development files
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~

# Documentation
README.md
SECURITY_AUDIT_REPORT.md
*.md

# Configuration examples (not actual configs)
.env.example
config.json.example

# Real secrets and configuration — these are gitignored, so they only ever exist
# in a local working tree. Without these rules a local `docker build` bakes live
# credentials into an image layer (the Dockerfile does `COPY . .`).
.env
.env.*
**/.env
config*.json
**/config*.json

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Build artifacts
dist/
build/

# Temporary files
tmp/
temp/

