# Actual Budget Configuration
#
# Plaintext http:// is accepted only for a host that is reachable from a local
# network: localhost, a 10/172.16-31/192.168 address, or a single-label name such
# as a Docker Compose service (http://actual_server:5006). Any other host must be
# https://, in every environment — otherwise the password below crosses a network
# in the clear. This does not depend on NODE_ENV.
ACTUAL_BUDGET_URL=http://localhost:5006
# Minimum 8 characters
ACTUAL_BUDGET_PASS=your-actual-server-password
ACTUAL_BUDGET_SYNC_ID=your-budget-sync-id
# Must be an absolute path to an existing, writable directory. In the container
# this is the volume mount (/actual-budget) and docker-compose.yml sets it, so
# leave it as-is unless you are running the sync outside Docker.
ACTUAL_BUDGET_DATA_DIR=/actual-budget

# Ghostfolio Configuration
GHOSTFOLIO_URL=http://localhost:3333
# The anonymous-user security token from Ghostfolio (a UUID). Minimum 16 characters.
GHOSTFOLIO_TOKEN=your-access-token

# Application Configuration
NODE_ENV=production
LOG_LEVEL=info

# Resolve every mapping and report what would change, without writing anything to
# Ghostfolio. Worth one run after editing config.json: the only thing this tool
# does to Ghostfolio is overwrite account balances.
# DRY_RUN=true

# Retry Configuration (Optional). Retries per request against Ghostfolio, for
# network errors and HTTP 429; 0 disables retrying.
MAX_RETRIES=3

# Logging (Optional). Defaults to <app root>/logs, which is the mounted volume in
# the container. Set this if the app root is not writable.
# GHOSTBUDGET_LOG_DIR=/app/logs
