# Actual Budget Configuration
ACTUAL_BUDGET_URL=http://localhost:5006
ACTUAL_BUDGET_PASS=your-actual-server-password
ACTUAL_BUDGET_SYNC_ID=your-budget-sync-id
# Must be an absolute path to an existing, writable directory. In the container
# this is the volume mount (/actual-budget) and docker-compose.yml sets it, so
# leave it as-is unless you are running the sync outside Docker.
ACTUAL_BUDGET_DATA_DIR=/actual-budget

# Ghostfolio Configuration
GHOSTFOLIO_URL=http://localhost:3333
GHOSTFOLIO_TOKEN=your-access-token

# Application Configuration
NODE_ENV=production
LOG_LEVEL=info

# Performance Configuration (Optional)
CACHE_TTL_MINUTES=5
BATCH_SIZE=10
MAX_RETRIES=3
