    "dotenv": "17.4.2",
    "joi": "18.2.3",
    "opossum": "^9.0.0",
    "rate-limiter-flexible": "^11.2.0",
    "uuid": "^14.0.1",
    "validator": "^13.15.35",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "eslint": "10.5.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-security": "4.0.1",
