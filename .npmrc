# Refuse to install on a Node or npm below the floor in package.json, rather than
# printing a warning and continuing. Without this, `engines` is advisory: npm notes the
# mismatch and installs anyway, so the README's claim that the floor is enforced would
# not be true. This tool moves financial balances between two APIs; a runtime older than
# the one the suite and the image are built on is not something to discover at 5am.
engine-strict=true

# Nothing else belongs in this file. It is inside the Docker build context and is
# COPYed before `npm ci`, so a registry token added here would be baked into an image
# layer. Credentials go in the environment, never in a committed .npmrc.
